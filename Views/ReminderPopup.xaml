<Window x:Class="GameTracker.Views.ReminderPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game reminder"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowActivated="False" ShowInTaskbar="True"
        Icon="/iguana-eye.ico"
        Background="{DynamicResource ScaleBrush}">

    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface2}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource ThemeAccentDeep}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeAccentDeep}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource ThemeAccent2}" BorderThickness="2">
        <StackPanel Margin="14,12,14,12">
            <TextBlock Text="&#9200; REMINDER" Foreground="{DynamicResource ThemeAccent2}"
                       FontSize="11" FontWeight="Bold"/>
            <TextBlock x:Name="GameTitle" Foreground="{DynamicResource ThemeText}" FontSize="17"
                       FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock x:Name="NoteText" Foreground="{DynamicResource ThemeText}" FontSize="13"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock x:Name="WhenText" Foreground="{DynamicResource ThemeTextFaint}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="Turn off" Click="TurnOff_Click" Style="{StaticResource Btn}" Foreground="#e89080"
                        ToolTip="Stop reminding me about this game"/>
                <Button Grid.Column="2" Content="Snooze 10 min" Click="Snooze_Click" Style="{StaticResource Btn}"
                        Margin="0,0,6,0" ToolTip="Remind me again in 10 minutes"/>
                <Button Grid.Column="3" Content="Got it" Click="GotIt_Click" Style="{StaticResource Btn}"
                        ToolTip="Close — I'll be reminded again on schedule"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
