<Window x:Class="GameTracker.Views.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Game reminder"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Icon="/iguana-eye.ico"
        Background="{DynamicResource ScaleBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="In" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface2}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource ThemeAccentDeep}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeAccentDeep}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource ThemeAccentDeep}" BorderThickness="1">
        <StackPanel>
            <!-- Title bar -->
            <Border Height="32" Background="{DynamicResource ThemeBg}"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#9200; GAME REMINDER" Foreground="{DynamicResource ThemeAccent}"
                               FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Button Grid.Column="1" Content="&#x2715;" Click="Cancel_Click"
                            Style="{StaticResource WindowCloseButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <StackPanel Margin="18,12,18,16">
                <TextBlock x:Name="GameTitle" Foreground="{DynamicResource ThemeText}" FontSize="16"
                           FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Text="Pops up a reminder at the time you pick, then keeps reminding you until you turn it off."
                           Foreground="{DynamicResource ThemeTextFaint}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>

                <TextBlock Text="First reminder" Style="{StaticResource Lbl}"/>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="DayBox" Width="168"/>
                    <ComboBox x:Name="HourBox" Width="56" Margin="8,0,0,0"/>
                    <TextBlock Text=":" Foreground="{DynamicResource ThemeTextDim}" VerticalAlignment="Center" Margin="4,0"/>
                    <ComboBox x:Name="MinuteBox" Width="56"/>
                    <ComboBox x:Name="AmPmBox" Width="60" Margin="6,0,0,0"/>
                </StackPanel>

                <TextBlock Text="Then remind me" Style="{StaticResource Lbl}"/>
                <ComboBox x:Name="RepeatBox" Width="200" HorizontalAlignment="Left"/>
                <StackPanel x:Name="CustomRow" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                    <TextBlock Text="Every" Foreground="{DynamicResource ThemeTextDim}" FontSize="12"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="CustomNum" Style="{StaticResource In}" Width="56" Margin="8,0" MaxLength="3"
                             HorizontalContentAlignment="Center"/>
                    <ComboBox x:Name="CustomUnit" Width="100"/>
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="#e89080" FontSize="11" TextWrapping="Wrap"
                           Margin="0,6,0,0" Visibility="Collapsed"/>

                <TextBlock Text="Note (optional)" Style="{StaticResource Lbl}"/>
                <TextBox x:Name="NoteBox" Style="{StaticResource In}" MaxLength="140"
                         ToolTip="Shown on the pop-up, e.g. &quot;Stream it Saturday!&quot;"/>

                <TextBlock x:Name="Hint" Foreground="{DynamicResource ThemeAccent2}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TurnOffBtn" Content="Turn off reminder" Click="TurnOff_Click"
                            Style="{StaticResource Btn}" Foreground="#e89080" Visibility="Collapsed"/>
                    <Button Grid.Column="2" Content="Cancel" Click="Cancel_Click" Style="{StaticResource Btn}" Margin="0,0,8,0"/>
                    <Button Grid.Column="3" Content="Save" Click="Save_Click" Style="{StaticResource Btn}" IsDefault="True"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
