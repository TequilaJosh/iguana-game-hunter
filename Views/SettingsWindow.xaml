<Window x:Class="GameTracker.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Settings"
        Width="620" Height="600"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Icon="/iguana-eye.ico"
        Background="{DynamicResource ScaleBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SecHdr" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#a8c488"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="120"/>
        </Style>
        <Style x:Key="In" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
            <Setter Property="Foreground" Value="#e8e0c4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface2}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource ThemeAccentDeep}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeAccentDeep}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Left-nav item -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#c4d4a8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="0,0,0,0">
                            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ThemeSurface}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ThemeSurface2}"/>
                                <Setter TargetName="b" Property="BorderThickness" Value="3,0,0,0"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource ThemeAccentDeep}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource ThemeBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Image Source="/iguana-eye.ico" Width="16" Height="16" Margin="0,0,8,0"
                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="SETTINGS" Foreground="{DynamicResource ThemeAccent}" FontSize="11"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#x2715;" Click="Close_Click"
                            Style="{StaticResource WindowCloseButton}" Height="32"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <!-- Body: left nav + content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource ThemeBg}"
                        BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <Button x:Name="NavAppearance" Content="Appearance" Tag="active"
                                Style="{StaticResource NavBtn}" Click="Nav_Click"/>
                        <Button x:Name="NavChat" Content="Chat" Style="{StaticResource NavBtn}" Click="Nav_Click"/>
                        <Button x:Name="NavOverlay" Content="Overlay" Style="{StaticResource NavBtn}" Click="Nav_Click"/>
                        <Button x:Name="NavHelp" Content="How to" Style="{StaticResource NavBtn}" Click="Nav_Click"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1">
                    <!-- ===== Appearance ===== -->
                    <ScrollViewer x:Name="PanelAppearance" VerticalScrollBarVisibility="Auto" Padding="18,14,18,16">
                        <StackPanel>
                            <TextBlock Text="THEME" Style="{StaticResource SecHdr}"/>
                            <TextBlock Foreground="#7a9070" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Pick a preset or set your own colors. Applies to the whole app instantly."/>
                            <ItemsControl x:Name="PresetList" Margin="0,0,0,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="Preset_Click" Tag="{Binding}" Cursor="Hand" Margin="0,0,8,8">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}"
                                                            BorderThickness="1" CornerRadius="6" Padding="8,6">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <Border Width="16" Height="16" CornerRadius="3" Margin="0,0,3,0">
                                                                    <Border.Background><SolidColorBrush Color="{Binding AccentColor}"/></Border.Background>
                                                                </Border>
                                                                <Border Width="16" Height="16" CornerRadius="3" Margin="0,0,3,0">
                                                                    <Border.Background><SolidColorBrush Color="{Binding Accent2Color}"/></Border.Background>
                                                                </Border>
                                                                <Border Width="16" Height="16" CornerRadius="3">
                                                                    <Border.Background><SolidColorBrush Color="{Binding BgColor}"/></Border.Background>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding PresetName}" Foreground="#e8e0c4" FontSize="11"
                                                                       HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="0.8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Custom colors" Foreground="#a8c488" FontSize="12" Margin="0,0,0,6"/>
                            <StackPanel x:Name="CustomColors"/>
                            <Button Content="&#8635; Reset to default (Reptile)" Click="ResetTheme_Click"
                                    Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Chat ===== -->
                    <ScrollViewer x:Name="PanelChat" VerticalScrollBarVisibility="Auto" Padding="18,14,18,16"
                                  Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="CHAT" Style="{StaticResource SecHdr}"/>
                            <CheckBox x:Name="AutoConnectCheck" Content="Auto-connect chats when a game session starts"
                                      Foreground="#e8e0c4" FontSize="12" Margin="0,0,0,12"
                                      Checked="AutoConnect_Changed" Unchecked="AutoConnect_Changed"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Chat window transparency" Foreground="#a8c488" FontSize="12"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.25" Maximum="1.0" Value="1.0"
                                        VerticalAlignment="Center" Foreground="{DynamicResource ThemeAccent}"
                                        ValueChanged="Opacity_Changed"
                                        ToolTip="Make the chat window see-through (applies live if it's open)"/>
                            </Grid>
                            <TextBlock Text="TEXT TO SPEECH" Style="{StaticResource SecHdr}"/>
                            <CheckBox x:Name="TtsEnabled" Content="Read incoming chat messages aloud"
                                      Foreground="#e8e0c4" FontSize="12" Margin="0,0,0,8"
                                      Checked="Tts_Changed" Unchecked="Tts_Changed"/>
                            <CheckBox x:Name="TtsPerChatter" Content="Give each chatter their own random voice (saved per person)"
                                      Foreground="#a8c488" FontSize="12" Margin="0,0,0,8"
                                      Checked="TtsPerChatter_Changed" Unchecked="TtsPerChatter_Changed"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TtsVoiceLbl" Text="Voice" Style="{StaticResource Lbl}"/>
                                <ComboBox x:Name="TtsVoice" Grid.Column="1" DisplayMemberPath="Label"
                                          SelectionChanged="Tts_Changed"/>
                                <Button Grid.Column="2" Content="&#9654; Test" Click="TtsTest_Click"
                                        Style="{StaticResource Btn}" Margin="8,0,0,0"/>
                            </Grid>
                            <Button Content="&#127908; Voice Lab — make your own voices" Click="VoiceLab_Click"
                                    Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,0,0,8"
                                    ToolTip="Build, test and save custom voices (base voice + funny effect)"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Speed" Style="{StaticResource Lbl}"/>
                                <Slider x:Name="TtsRate" Grid.Column="1" Minimum="-10" Maximum="10" Value="0"
                                        VerticalAlignment="Center" Foreground="{DynamicResource ThemeAccent}"
                                        ValueChanged="Tts_Slider" IsSnapToTickEnabled="True" TickFrequency="1"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Volume" Style="{StaticResource Lbl}"/>
                                <Slider x:Name="TtsVolume" Grid.Column="1" Minimum="0" Maximum="100" Value="100"
                                        VerticalAlignment="Center" Foreground="{DynamicResource ThemeAccent}"
                                        ValueChanged="Tts_Slider"/>
                            </Grid>
                            <CheckBox x:Name="TtsReadName" Content="Say the sender's name (&quot;Name says: …&quot;)"
                                      Foreground="#a8c488" FontSize="12" Margin="0,0,0,4"
                                      Checked="Tts_Changed" Unchecked="Tts_Changed"/>
                            <CheckBox x:Name="TtsSkipCommands" Content="Skip ! commands"
                                      Foreground="#a8c488" FontSize="12" Margin="0,0,0,4"
                                      Checked="Tts_Changed" Unchecked="Tts_Changed"/>
                            <TextBlock Foreground="#7a9070" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="Reads all connected chats. On busy streams, extra messages are skipped so it can't fall behind. The chat window's 🔇 panic button also stops speech."/>

                            <TextBlock Text="TOOLS" Style="{StaticResource SecHdr}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="&#9881; Features" Click="Features_Click" Style="{StaticResource Btn}"
                                        Margin="0,0,8,0"
                                        ToolTip="Chatter counts, points, chat style, and point redeems"/>
                                <Button Content="&#128266; Sound Alerts" Click="SoundAlerts_Click" Style="{StaticResource Btn}"
                                        ToolTip="Chat commands that play your own sound files"/>
                            </StackPanel>
                            <TextBlock Foreground="#7a9070" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="The live Chatters list stays in the chat window (it shows who's active right now)."/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Overlay ===== -->
                    <ScrollViewer x:Name="PanelOverlay" VerticalScrollBarVisibility="Auto" Padding="18,14,18,16"
                                  Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="OBS OVERLAY" Style="{StaticResource SecHdr}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Overlay port" Style="{StaticResource Lbl}"/>
                                <TextBox x:Name="PortBox" Style="{StaticResource In}" Width="70" MaxLength="5" Margin="0,0,8,0"/>
                                <Button Content="Apply" Click="ApplyPort_Click" Style="{StaticResource Btn}" Margin="0,0,6,0"/>
                                <Button Content="Copy URL" Click="CopyUrl_Click" Style="{StaticResource Btn}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Chat lines" Style="{StaticResource Lbl}"/>
                                <TextBox x:Name="ChatLinesBox" Style="{StaticResource In}" Width="70" MaxLength="3"
                                         LostFocus="ChatLines_Changed"/>
                                <TextBlock Text="5–100 (refresh OBS source to apply)" Foreground="#506050"
                                           FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="&#127912; Edit overlay layout" Click="EditLayout_Click"
                                        Style="{StaticResource Btn}" Margin="0,0,8,0"
                                        ToolTip="Open the overlay in your browser to drag/resize blocks and set fonts"/>
                                <Button Content="&#128221; Text overlays" Click="TextPanels_Click"
                                        Style="{StaticResource Btn}"
                                        ToolTip="Up to 5 custom text panels for OBS"/>
                            </StackPanel>
                            <TextBlock x:Name="OverlayStatus" Foreground="#7a9070" FontSize="11" Margin="0,10,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== How to ===== -->
                    <ScrollViewer x:Name="PanelHelp" VerticalScrollBarVisibility="Auto" Padding="18,14,18,16"
                                  Visibility="Collapsed">
                        <StackPanel x:Name="HelpContent"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
