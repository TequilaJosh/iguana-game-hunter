<Window x:Class="GameTracker.Views.TrackerCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Built-in tracker sets"
        Width="460" Height="560"
        MinWidth="380" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="False"
        Icon="/iguana-eye.ico"
        Background="{DynamicResource ScaleBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface2}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource ThemeAccentDeep}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeAccentDeep}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource ThemeAccentDeep}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource ThemeBg}"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Image Source="/iguana-eye.ico" Width="16" Height="16" Margin="0,0,8,0"
                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="BUILT-IN TRACKER SETS" Foreground="{DynamicResource ThemeAccent}"
                                   FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#x2715;" Click="Cancel_Click"
                            Style="{StaticResource WindowCloseButton}" Height="32"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <!-- Search -->
            <StackPanel Grid.Row="1" Margin="14,12,14,8">
                <TextBlock Foreground="{DynamicResource ThemeTextFaint}" FontSize="11" TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           Text="Pick one or more games (Ctrl-click for several). Each one is copied into your own list, so you can rename, add and delete anything afterwards without losing the original."/>
                <TextBox x:Name="FilterBox" FontSize="13" Padding="8,6"
                         Background="{DynamicResource ThemeSurface}" Foreground="{DynamicResource ThemeText}"
                         BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                         CaretBrush="{DynamicResource ThemeAccent}" VerticalContentAlignment="Center"
                         TextChanged="Filter_Changed"
                         ToolTip="Search by game or console"/>
            </StackPanel>

            <!-- List -->
            <ListBox x:Name="SetList" Grid.Row="2" Margin="14,0,14,0"
                     SelectionMode="Extended" MouseDoubleClick="List_DoubleClick"
                     Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}"
                     BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource ThemeAccentDeep}" CornerRadius="3"
                                    Padding="4,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding System}" Foreground="{DynamicResource ThemeBg}"
                                           FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemeText}"
                                           FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource ThemeTextFaint}"
                                           FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Count}" VerticalAlignment="Center"
                                       Margin="8,0,4,0" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeAccent}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer -->
            <Grid Grid.Row="3" Margin="14,10,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CountText" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource ThemeTextFaint}" TextWrapping="Wrap"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource Btn}" Margin="0,0,7,0"/>
                    <Button x:Name="AddBtn" Content="Add" Click="Ok_Click" Style="{StaticResource Btn}"
                            Background="{DynamicResource ThemeAccentDeep}" Foreground="{DynamicResource ThemeBg}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
