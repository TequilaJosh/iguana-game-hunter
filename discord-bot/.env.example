# ── Discord ────────────────────────────────────────────────────────────────
# Bot token: Developer Portal → your app → Bot → Reset Token. KEEP THIS SECRET.
DISCORD_TOKEN=
# Application (client) ID: Developer Portal → General Information → Application ID.
CLIENT_ID=

# ── Hosting ──────────────────────────────────────────────────────────────────
# Port the clip ingest HTTP server listens on. Most hosts set PORT automatically.
PORT=8080
# Your bot's public base URL (no trailing path). Shown in /setup ingest so streamers
# know exactly what to paste into Game Hunter. e.g. https://yourbot.up.railway.app
PUBLIC_URL=
# Where per-server settings are stored. On a host, point this at a PERSISTENT volume
# so servers don't lose their config + ingest tokens on redeploy.
DATA_DIR=./data

# ── Twitch chat (optional) ───────────────────────────────────────────────────
# Runs Tavern Tales directly in Twitch chat. Each server picks its channel with
# /setup twitch <channel>. Leave blank to disable.
#   USERNAME/OAUTH: a Twitch BOT ACCOUNT to chat as. Log into that account and get a
#   chat token (scopes chat:read + chat:edit), e.g. from https://twitchtokengenerator.com
#   — paste the "oauth:..." value into TWITCH_BOT_OAUTH.
TWITCH_BOT_USERNAME=
TWITCH_BOT_OAUTH=
#   CLIENT_ID/SECRET (optional): a Twitch app (dev.twitch.tv/console/apps) — only needed
#   so the bot JOINS a channel when it goes live and leaves when offline. Without these,
#   the bot just stays in the configured channels.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Admin (player editor) ────────────────────────────────────────────────────
# Password for the web player-editor at /admin (fix stuck players, hand out gifts,
# edit stats/inventory). Set a strong secret; leave blank to disable the panel.
ADMIN_TOKEN=

# NOTE: There are no per-server channel IDs or ingest tokens here anymore — each
# server configures itself in Discord with the /setup command.
