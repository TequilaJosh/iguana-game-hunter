# ── Discord ────────────────────────────────────────────────────────────────
# Bot token: Developer Portal → your app → Bot → Reset Token. KEEP THIS SECRET.
DISCORD_TOKEN=
# Application (client) ID: Developer Portal → General Information → Application ID.
CLIENT_ID=
# Your server ID: enable Developer Mode in Discord, right-click the server → Copy Server ID.
GUILD_ID=

# Channel IDs (right-click a channel → Copy Channel ID).
CLIP_CHANNEL_ID=
WELCOME_CHANNEL_ID=
# Optional: role auto-assigned to new members on join (role ID). Leave blank to skip.
AUTOROLE_ID=
# Optional: channel for join/moderation logs. Leave blank to skip.
LOG_CHANNEL_ID=

# ── Clip ingest (Game Hunter → this bot) ───────────────────────────────────
# A long random secret. Put the SAME value in Game Hunter → Features → Discord.
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INGEST_TOKEN=
# Port the ingest HTTP server listens on. Most hosts set PORT automatically.
PORT=8080
